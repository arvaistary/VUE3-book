# Скопируйте в workflow/project/technology-profile.env и замените значения.
# Это доверенная конфигурация репозитория, не shell-скрипт и не хранилище
# секретов. Команды выполняются project adapter-ом после проверки профиля.
PROFILE_VERSION=1
PROFILE_ID=<project-id>
EVIDENCE_MODE=product
COMMAND_WORKDIR=product

# Команды должны воспроизводимо запускаться из корня, указанного выше.
TEST_COMMAND_LOCAL=<unit-and-integration-test-command>
LINT_COMMAND_LOCAL=<lint-or-static-analysis-command>

# Если runtime отличается от local, укажите его явно.
# TEST_COMMAND_PROJECT_RUNTIME=<production-like-test-command>
# LINT_COMMAND_PROJECT_RUNTIME=<production-like-lint-command>
# RUNTIME_SERVICE=<service-name>

# Роли артефактов для технологически нейтральных spec-файлов.
# ARTIFACT_SECURITY_TEST=<path-or-glob>
# ARTIFACT_CONCURRENCY_TEST=<path-or-glob>
# ARTIFACT_LIVE_SIDE_EFFECT_TEST=<path-or-glob>
# ARTIFACT_E2E=<path-or-glob>

# Для обязательной concurrency-проверки:
# CONCURRENCY_RUNTIME=<profile-runtime-label>
# CONCURRENCY_COMMAND=<production-like-concurrency-command>

# Для E2E, если adapter запускает сценарий сам:
# E2E_COMMAND_TEMPLATE=<command with %s for scenario path>
# E2E_PATH_PREFIX=<allowed-scenario-prefix>
# E2E_FIXTURE_ROOT=<allowed-fixture-root>

# Если есть semantic evidence checker:
# EVIDENCE_CHECKER=workflow/project/check-project-evidence.sh
